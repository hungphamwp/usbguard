<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>UsbGuard</AssemblyName>
    <RootNamespace>UsbGuard</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <Version>1.2.0</Version>
    <ApplicationIcon>assets\usbguard.ico</ApplicationIcon>
    <Company>UsbGuard</Company>
    <Product>UsbGuard</Product>
    <Description>UsbGuard - Chan USB flash disk tren Windows</Description>
    <Copyright>Copyright 2026 Pham Van Hung</Copyright>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
